// Cloudflare Workers static-assets deploy: Workers Builds runs `npm run build`, then `npx wrangler deploy`,
// which uploads dist/ as-is (no Worker script; the site is fully static).
{
  "name": "bayeux-tapestry",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
