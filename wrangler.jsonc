// Cloudflare Workers static-assets deploy: Workers Builds runs `npm run build`, then `npx wrangler deploy` on the
// production branch or `npx wrangler preview` on other branches; both upload dist/ as-is (no Worker script).
{
  "name": "bayeux-tapestry",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview` (branch previews); it can stay empty.
  "previews": {}
}
